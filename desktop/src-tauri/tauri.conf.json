{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LLM Pro Mode Desktop",
  "version": "0.1.0",
  "identifier": "ai.llm.pro.mode",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LLM Pro Mode Desktop",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null,
      "dangerousDisableAssetCspModification": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}